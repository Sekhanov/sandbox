# Copy to .env and fill in. Never commit .env. Names are the same as in the services.
# Client DBs require SSL. no-verify: encrypted, certificate not checked (as in IntelliJ).
PGSSLMODE=no-verify

# SMA RDS of the region (scripts 00, 02): compliance-security-master RDS_*
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=
RDS_USERNAME=
RDS_PASSWORD=

# Central DB rulesenginedb (script 02): compliance-rules-engine DB_*
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Client DB (scripts 03, 04, 05), change per client: compliance-rules-engine CLIENT_DB_*
CLIENT_DB_HOST=
CLIENT_DB_PORT=5432
CLIENT_DB_NAME=
CLIENT_DB_USERNAME=
CLIENT_DB_PASSWORD=
