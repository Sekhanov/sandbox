# Copy to .env and fill in. Never commit .env.
# Keep passwords out of this file: put them in ~/.pgpass (mode 600), which pg reads automatically.

# SMA database of the region (scripts 00, 01)
SMA_DB_URL=postgresql://user@sma-host:5432/postgres?sslmode=verify-full

# Central database rulesenginedb (script 02)
CENTRAL_DB_URL=postgresql://user@central-host:5432/rulesenginedb?sslmode=verify-full

# Client database (scripts 03, 04, 05). Change it for each client.
CLIENT_DB_URL=postgresql://user@client-host:5432/clientdb?sslmode=verify-full
